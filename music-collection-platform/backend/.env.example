# ================= 后端配置模板 =================
# 使用方式：复制本文件为同目录下的 .env，再按本机情况修改。

# ---- 数据库（默认 MySQL）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=music_collection

# ---- 零配置演示模式：设为 1 时改用 SQLite，无需安装 MySQL ----
# 打开后执行 python init_db.py / python run.py 即可直接跑通全部接口。
USE_SQLITE=0
# SQLITE_PATH=D:/music_collection.db

# ---- 服务 ----
PORT=5000
SECRET_KEY=music-collection-desktop-dev-secret-key-2026
TOKEN_EXPIRE_DAYS=7

# ---- 初始化管理员账号（执行 init_db.py 时生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 演示数据：首次启动自动给管理员播种示例歌单 / 标签 / 歌曲 ----
# 含 8 首可离线试听的原创演示音频；设为 0 可关闭，已有收藏不会被覆盖
SEED_DEMO_DATA=1
